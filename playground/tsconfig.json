{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@phpsoftbox/react-softbox": ["../src/index.ts"],
      "@phpsoftbox/react-softbox/*": ["../src/*"]
    }
  }
}
